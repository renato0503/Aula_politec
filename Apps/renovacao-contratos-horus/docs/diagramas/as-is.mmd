%% Fluxograma ASIS · 6 etapas
flowchart TD
  IN(["Início"])
  N1["1. Monitoramento e gatilho"]:::wait
  N2["2. Decisão e instrução"]:::wait
  N3["3. Registro do termo aditivo"]:::wait
  N4["4. Alteração financeira, quando aplicável"]:::wait
  N5["5. Atualização da vigência"]:::wait
  N6["6. Efeitos e encerramento do fluxo"]:::wait
  FIM(["Fim"])
  IN --> N1
  N1 --> N2
  N2 --> N3
  N3 --> N4
  N4 --> N5
  N5 --> N6
  N6 --> FIM
  classDef manual fill:#fff4e5,stroke:#a35f00,color:#3b2a00;
  classDef wait fill:#fff4e5,stroke:#a35f00,stroke-dasharray:5 3,color:#3b2a00;
  classDef auto fill:#eef8f2,stroke:#127a45,color:#0b3b23;
  classDef humano fill:#eef3fa,stroke:#12487f,color:#0a2f5c;
