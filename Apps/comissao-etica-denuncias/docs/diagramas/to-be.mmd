%% Fluxograma TOBE · 12 etapas
flowchart TD
  IN(["Início"])
  N1["1. Recebimento e registro da denúncia<br/><small>A máquina (automação)</small>"]:::auto
  N2["2. Classificação inicial da denúncia<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  N3["3. Análise de admissibilidade<br/><small>A pessoa, sem mudança</small>"]:::humano
  N4["4. Comunicação da decisão de admissibilidade<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  N5["5. Distribuição e acompanhamento do caso<br/><small>A máquina (automação)</small>"]:::auto
  N6["6. Preparação das oitivas<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  N7["7. Realização e registro das oitivas<br/><small>A pessoa, sem mudança</small>"]:::humano
  N8["8. Análise dos fatos e deliberação<br/><small>A pessoa, sem mudança</small>"]:::humano
  N9["9. Elaboração de parecer ou orientação<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  N10["10. Comunicação dos encaminhamentos<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  N11["11. Encerramento e arquivamento<br/><small>A máquina (automação)</small>"]:::auto
