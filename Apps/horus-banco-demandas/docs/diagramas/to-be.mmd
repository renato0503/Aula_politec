%% Fluxograma TOBE · 5 etapas
flowchart TD
  IN(["Início"])
  N1["1. Cadastrar demanda<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  N2["2. Disponibilizar no banco<br/><small>A máquina (automação)</small>"]:::auto
  N3["3. Manifestar interesse<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  N4["4. Aprovar para o ciclo<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  N5["5. Acompanhar<br/><small>A pessoa assistida pela máqui…</small>"]:::auto
  FIM(["Fim"])
  IN --> N1
  N1 --> N2
  N2 --> N3
  N3 --> N4
  N4 --> N5
  N5 --> FIM
  classDef manual fill:#fff4e5,stroke:#a35f00,color:#3b2a00;
  classDef wait fill:#fff4e5,stroke:#a35f00,stroke-dasharray:5 3,color:#3b2a00;
  classDef auto fill:#eef8f2,stroke:#127a45,color:#0b3b23;
  classDef humano fill:#eef3fa,stroke:#12487f,color:#0a2f5c;
